# Copy to .env and fill in. Never commit .env.

# XRPL network — testnet for practice, mainnet for launch.
# Testnet: wss://s.altnet.rippletest.net:51233
# Mainnet: wss://xrplcluster.com
XRPL_NETWORK_URL=wss://s.altnet.rippletest.net:51233

# Family seed (s…) of the minter wallet. Use a DEDICATED wallet, never your main.
# On testnet you can fund a fresh wallet via the faucet (see README).
WALLET_SEED=

# Collection display name (used in log output / your own records).
COLLECTION_NAME=My Collection

# XLS-20 taxon: uint32 grouping id for this drop. Same taxon = same series.
NFT_TAXON=0

# Transfer fee in units of 1/100,000. 0 = none, 1000 = 1%, 50000 = 50% (max).
# Only applies to secondary sales, and only if the NFToken is transferable.
TRANSFER_FEE=0

# HTTPS/IPFS link to the off-chain metadata JSON (hex-encoded into the URI field, max 256 bytes).
METADATA_URI=

# Filled in after running the scripts
NFTOKEN_ID=
LIST_PRICE_XRP=10
OFFER_INDEX=
